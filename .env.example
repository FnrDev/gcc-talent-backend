MONGODB_URI=mongodb://127.0.0.1:27017/gcc-talent
PORT=3000
# Frontend base URL: used for CORS and password reset links. Use public HTTPS in production.
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Copy your Resend sending key here. Never commit the real .env file.
RESEND_API_KEY=
# Required: use an address on a domain verified in your Resend account.
# For local testing only, use "GCC Talent <onboarding@resend.dev>".
# The test sender is limited to your Resend account email and Resend test recipients.
RESEND_FROM_EMAIL="GCC Talent <noreply@your-domain.com>"
# The backend URL used in verification links, NOT the frontend CLIENT_URL.
# In production, set this to your public HTTPS API URL (including any base path).
API_BASE_URL=http://localhost:3000

# Cloudflare R2 attachment uploads. The bucket name is fixed to "gcc-talent".
# Create bucket-scoped Object Read & Write credentials and keep them server-side.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set to eu, us, or fedramp only if this bucket was created in that jurisdiction.
R2_JURISDICTION=default
# Production: use the bucket's custom domain. An enabled r2.dev URL is suitable only for development.
R2_PUBLIC_BASE_URL=https://files.your-domain.com
